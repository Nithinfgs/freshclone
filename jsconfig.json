{
  "compilerOptions": {
    "target": "es2023", "module": "nodenext", "moduleResolution": "nodenext",
    "checkJs": true, "allowJs": true, "noEmit": true, "strict": true, "skipLibCheck": true, "maxNodeModuleJsDepth": 0,
    "types": ["node"]
  },
  "include": ["src", "bin", "test", "scripts"],
  "exclude": ["node_modules"]
}
